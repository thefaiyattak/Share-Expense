rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOfTeam(teamId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
      );
    }

    function isTeamAdmin(teamId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/teams/$(teamId)).data.adminId == request.auth.uid ||
        getUserData().role == 'admin'
      );
    }

    // 1. users/{uid}
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isUser(uid);
      allow update: if isUser(uid) || (
        isAuthenticated() && resource.data.teamId != null && isTeamAdmin(resource.data.teamId)
      );
      allow delete: if isUser(uid);
    }

    // 2. teams/{teamId}
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.adminId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
    }

    // 3. expenses/{expId}
    match /expenses/{expId} {
      allow read: if isAuthenticated() && isMemberOfTeam(resource.data.teamId);
      allow create: if isAuthenticated() &&
        isMemberOfTeam(request.resource.data.teamId) &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isMemberOfTeam(resource.data.teamId) && (
        resource.data.userId == request.auth.uid ||
        isTeamAdmin(resource.data.teamId)
      );
    }

    // 4. attendance/{attId}
    match /attendance/{attId} {
      allow read: if isAuthenticated() && (
        resource.data.teamId == null || isMemberOfTeam(resource.data.teamId)
      );
      allow create, update, delete: if isAuthenticated() && (
        request.resource.data.teamId == null || isMemberOfTeam(request.resource.data.teamId)
      );
    }

    // 5. editHistory/{id} - Append-only audit log: no updates, no deletes
    match /editHistory/{id} {
      allow read: if isAuthenticated() && (
        resource.data.teamId == null || isMemberOfTeam(resource.data.teamId)
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 6. syncOps/{opId} - Idempotency tracking markers
    match /syncOps/{opId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 7. personal_loans/{loanId} - Strictly private between lender & borrower
    match /personal_loans/{loanId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.lenderId == request.auth.uid ||
        resource.data.borrowerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.lenderId == request.auth.uid ||
        request.resource.data.borrowerId == request.auth.uid
      );
    }

    // 8. notifications/{id}
    match /notifications/{id} {
      allow read: if isAuthenticated() && (
        resource.data.teamId == null ||
        isMemberOfTeam(resource.data.teamId) ||
        (resource.data.readBy != null && request.auth.uid in resource.data.readBy)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.teamId == null || isMemberOfTeam(request.resource.data.teamId)
      );
      allow update, delete: if isAuthenticated();
    }
  }
}
